<?xml version="1.0" encoding="UTF-8"?>
<!-- LibLande's test add-in for Word: a side panel that checks whether a
     citation tool can work in Word (inserting at the cursor, and getting the
     library from Google Drive). Copied into Word's add-ins folder on the Mac
     (~/Library/Containers/com.microsoft.Word/Data/Documents/wef), it shows
     under Home > Add-ins. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>3b88e350-f89b-4dac-b7cb-bb64b2e2d46a</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Kevin Lande</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="LibLande test"/>
  <Description DefaultValue="Checks whether LibLande's citations can work in Word."/>
  <IconUrl DefaultValue="https://kevinlande.github.io/liblande/icon.png"/>
  <HighResolutionIconUrl DefaultValue="https://kevinlande.github.io/liblande/icon.png"/>
  <SupportUrl DefaultValue="https://kevinlande.github.io/liblande/"/>
  <AppDomains>
    <AppDomain>https://accounts.google.com</AppDomain>
    <AppDomain>https://kevinlande.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://kevinlande.github.io/liblande/word/test.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
